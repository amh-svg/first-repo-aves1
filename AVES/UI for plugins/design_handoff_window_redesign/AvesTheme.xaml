<!--
  AvesTheme.xaml — AVES "Refined Native" design tokens + base styles
  =================================================================
  Drop this in (e.g.) AVES/Theme/AvesTheme.xaml, set Build Action = Page,
  and merge it once at startup so every window can reference the keys:

      var dict = new ResourceDictionary {
          Source = new Uri("/AVES;component/Theme/AvesTheme.xaml", UriKind.Relative)
      };
      Application.Current.Resources.MergedDictionaries.Add(dict);

  (If the add-in has no App/Application instance, merge into each Window's
   Resources instead, or load via XamlReader once and cache it.)

  Apply by key in your programmatic windows:
      okButton.Style = (Style)Application.Current.FindResource("AvesPrimaryButton");
      grid.Style     = (Style)Application.Current.FindResource("AvesDataGrid");
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================== COLORS ============================== -->
  <!-- Brand accent (AVES Red) -->
  <Color x:Key="AvesAccentColor">#E64A2E</Color>
  <Color x:Key="AvesAccentDeepColor">#C2402A</Color>
  <Color x:Key="AvesAccentTintColor">#FBE9E4</Color>   <!-- selection / chips / focus / number badge -->

  <!-- Neutrals (cool) -->
  <Color x:Key="AvesBgColor">#F4F4F6</Color>           <!-- window backdrop -->
  <Color x:Key="AvesSurfaceColor">#FFFFFF</Color>
  <Color x:Key="AvesSurface2Color">#FAFAFB</Color>     <!-- footers, headers, inset panels -->
  <Color x:Key="AvesZebraColor">#F7F8FA</Color>        <!-- DataGrid alternating row -->
  <Color x:Key="AvesBorderColor">#E5E6EA</Color>
  <Color x:Key="AvesBorderStrongColor">#D4D6DC</Color>
  <Color x:Key="AvesTextColor">#1F2329</Color>
  <Color x:Key="AvesTextDimColor">#5A6069</Color>
  <Color x:Key="AvesTextFaintColor">#8B9099</Color>

  <!-- Semantic status (FIXED — never recolour with the accent) -->
  <Color x:Key="AvesOkBgColor">#E4F3EA</Color>   <Color x:Key="AvesOkFgColor">#2C7A52</Color>
  <Color x:Key="AvesSkipBgColor">#EDEFF2</Color> <Color x:Key="AvesSkipFgColor">#5B6573</Color>
  <Color x:Key="AvesFailBgColor">#FBE3DE</Color> <Color x:Key="AvesFailFgColor">#C0381F</Color>
  <Color x:Key="AvesWarnBgColor">#FAF0DA</Color> <Color x:Key="AvesWarnFgColor">#9A6B12</Color>
  <Color x:Key="AvesInfoBgColor">#E7EFFB</Color> <Color x:Key="AvesInfoFgColor">#2E66A8</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="AvesAccent"       Color="{StaticResource AvesAccentColor}"/>
  <SolidColorBrush x:Key="AvesAccentDeep"   Color="{StaticResource AvesAccentDeepColor}"/>
  <SolidColorBrush x:Key="AvesAccentTint"   Color="{StaticResource AvesAccentTintColor}"/>
  <SolidColorBrush x:Key="AvesBg"           Color="{StaticResource AvesBgColor}"/>
  <SolidColorBrush x:Key="AvesSurface"      Color="{StaticResource AvesSurfaceColor}"/>
  <SolidColorBrush x:Key="AvesSurface2"     Color="{StaticResource AvesSurface2Color}"/>
  <SolidColorBrush x:Key="AvesZebra"        Color="{StaticResource AvesZebraColor}"/>
  <SolidColorBrush x:Key="AvesBorder"       Color="{StaticResource AvesBorderColor}"/>
  <SolidColorBrush x:Key="AvesBorderStrong" Color="{StaticResource AvesBorderStrongColor}"/>
  <SolidColorBrush x:Key="AvesText"         Color="{StaticResource AvesTextColor}"/>
  <SolidColorBrush x:Key="AvesTextDim"      Color="{StaticResource AvesTextDimColor}"/>
  <SolidColorBrush x:Key="AvesTextFaint"    Color="{StaticResource AvesTextFaintColor}"/>

  <!-- ============================== FONTS ============================== -->
  <FontFamily x:Key="AvesUiFont">Segoe UI</FontFamily>
  <!-- Design used IBM Plex Mono for numerics; Consolas is the safe native
       fallback. Bundle Plex Mono only if you want an exact match. -->
  <FontFamily x:Key="AvesMonoFont">Consolas</FontFamily>

  <!-- ============================== TEXT STYLES ============================== -->
  <Style x:Key="AvesSectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AvesUiFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource AvesTextFaint}"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
    <!-- letter-spacing .09em + UPPERCASE: apply Typography or upcase the string,
         WPF has no letter-spacing; use a Run per char only if you must. -->
  </Style>

  <!-- ============================== BUTTONS ============================== -->
  <!-- Primary: accent fill, white text, 5px corners -->
  <Style x:Key="AvesPrimaryButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource AvesUiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{StaticResource AvesAccent}"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AvesAccentDeep}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary: white fill, 1px strong border -->
  <Style x:Key="AvesSecondaryButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource AvesUiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource AvesText}"/>
    <Setter Property="Background" Value="{StaticResource AvesSurface}"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource AvesBorderStrong}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AvesSurface2}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ghost: transparent, dim text (e.g. Cancel) -->
  <Style x:Key="AvesGhostButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource AvesUiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource AvesTextDim}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AvesSurface2}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================== DATAGRID ============================== -->
  <Style x:Key="AvesColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="FontFamily" Value="{StaticResource AvesUiFont}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource AvesTextFaint}"/>
    <Setter Property="Background" Value="{StaticResource AvesSurface2}"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="BorderBrush" Value="{StaticResource AvesBorderStrong}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
  </Style>

  <Style x:Key="AvesRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource AvesSurface}"/>
    <Style.Triggers>
      <Trigger Property="AlternationIndex" Value="1">
        <Setter Property="Background" Value="{StaticResource AvesZebra}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="AvesCell" TargetType="DataGridCell">
    <Setter Property="FontFamily" Value="{StaticResource AvesUiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource AvesText}"/>
    <Setter Property="Padding" Value="12,11"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Padding="{TemplateBinding Padding}" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AvesDataGrid" TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AvesBorder}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AvesBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{StaticResource AvesSurface}"/>
    <Setter Property="RowBackground" Value="{StaticResource AvesSurface}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource AvesZebra}"/>
    <Setter Property="AlternationCount" Value="2"/>
    <Setter Property="RowHeight" Value="42"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource AvesColumnHeader}"/>
    <Setter Property="CellStyle" Value="{StaticResource AvesCell}"/>
  </Style>

</ResourceDictionary>
